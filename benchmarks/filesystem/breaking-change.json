{
  "protocol": "mcp-manifest-demo",
  "serverName": "filesystem-corpus",
  "serverVersion": "2.0.0",
  "tools": [
    {
      "name": "read_file",
      "description": "Read a file from the workspace.",
      "risk": "read_only",
      "inputSchema": {
        "type": "object",
        "properties": {"path": {"type": "string"}},
        "required": ["path"]
      }
    },
    {
      "name": "write_file",
      "description": "Write contents to a file.",
      "risk": "external_write",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {"type": "string"},
          "content": {"type": "string"},
          "mode": {"type": "string"}
        },
        "required": ["path", "content", "mode"]
      }
    }
  ]
}
